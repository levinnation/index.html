<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Full Shows Archive</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0f0f0f;
      color: #fff;
    }

    header {
      padding: 20px;
      font-size: 22px;
      font-weight: bold;
      border-bottom: 1px solid #222;
    }

    #grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 15px;
      padding: 20px;
    }

    .card {
      background: #1b1b1b;
      border-radius: 12px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.15s ease;
    }

    .card:hover {
      transform: scale(1.03);
    }

    .thumb {
      width: 100%;
      height: 180px;
      object-fit: cover;
      background: #333;
    }

    .title {
      font-size: 13px;
      padding: 10px;
      line-height: 1.3;
    }

    #player {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #111;
      border-top: 1px solid #222;
      padding: 10px 15px;
      display: none;
      align-items: center;
      gap: 15px;
    }

    #player h3 {
      margin: 0;
      font-size: 14px;
      flex: 1;
    }

    audio {
      width: 60%;
    }
  </style>
</head>
<body>

<header>Full Shows Archive</header>

<div id="grid"></div>

<div id="player">
  <h3 id="nowPlaying">Now Playing</h3>
  <audio id="audio" controls></audio>
</div>

<script>
const RSS_URL = "https://archive.org/services/collection-rss.php?collection=NeilLevin";
const API = "https://api.rss2json.com/v1/api.json?rss_url=" + encodeURIComponent(RSS_URL);

const grid = document.getElementById("grid");
const player = document.getElementById("player");
const audio = document.getElementById("audio");
const nowPlaying = document.getElementById("nowPlaying");

fetch(API)
  .then(res => res.json())
  .then(data => {

    const items = data.items
      .sort((a, b) => new Date(b.pubDate) - new Date(a.pubDate));

    items.forEach(item => {

      const title = item.title.toLowerCase();
      if (!title.includes("full") && !title.includes("show") && !title.includes("set")) return;
      if (!item.enclosure || !item.enclosure.link) return;

      const img = item.thumbnail || item.enclosure.thumbnail || "";

      const card = document.createElement("div");
      card.className = "card";

      card.innerHTML = `
        <img class="thumb" src="${img || 'https://via.placeholder.com/300x300'}" />
        <div class="title">${item.title}</div>
      `;

      card.onclick = () => {
        audio.src = item.enclosure.link;
        audio.play();
        nowPlaying.textContent = item.title;
        player.style.display = "flex";
      };

      grid.appendChild(card);
    });

  })
  .catch(err => {
    grid.innerHTML = "<p style='padding:20px'>Error loading archive.</p>";
    console.error(err);
  });
</script>

</body>
</html>
