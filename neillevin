<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Full Shows Archive</title>

<style>
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #0f0f0f;
  color: white;
}

header {
  padding: 20px;
  text-align: center;
  font-size: 24px;
  font-weight: bold;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 15px;
  padding: 20px;
}

.card {
  background: #1c1c1c;
  border-radius: 12px;
  overflow: hidden;
  cursor: pointer;
  transition: 0.2s;
}

.card:hover {
  transform: scale(1.02);
}

.art {
  width: 100%;
  height: 180px;
  object-fit: cover;
  background: #333;
}

.info {
  padding: 10px;
}

.title {
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 5px;
}

.date {
  font-size: 12px;
  opacity: 0.7;
}

audio {
  width: 100%;
  margin-top: 8px;
}
</style>
</head>

<body>

<header>🎧 Full Shows Archive</header>
<div class="grid" id="grid">Loading...</div>

<script>
const RSS_URL = "https://archive.org/services/collection-rss.php?collection=NeilLevin";
const API = "https://api.rss2json.com/v1/api.json?rss_url=" + encodeURIComponent(RSS_URL);

fetch(API)
  .then(r => r.json())
  .then(data => {
    const grid = document.getElementById("grid");
    grid.innerHTML = "";

    data.items.forEach(item => {

      // audio
      const audio = item.enclosure?.link || "";

      // thumbnail (rss2json often gives thumbnail OR we fallback)
      const thumb =
        item.thumbnail ||
        item.enclosure?.thumbnail ||
        "https://archive.org/images/glogo.png";

      const card = document.createElement("div");
      card.className = "card";

      card.innerHTML = `
        <img class="art" src="${thumb}" />
        <div class="info">
          <div class="title">${item.title}</div>
          <div class="date">${item.pubDate}</div>
          <audio controls src="${audio}"></audio>
        </div>
      `;

      grid.appendChild(card);
    });
  })
  .catch(err => {
    document.getElementById("grid").innerHTML = "Failed to load RSS feed.";
    console.error(err);
  });
</script>

</body>
</html>
